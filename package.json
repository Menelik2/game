{
  "name": "apex-casino",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=@apex/api",
    "dev:web": "npm run dev --workspace=@apex/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspace=@apex/api --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "npm run seed --workspace=@apex/api"
  },
  "engines": {
    "node": ">=20"
  }
}
