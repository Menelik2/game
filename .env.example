NODE_ENV=development
DEMO_MODE=true
REAL_MONEY_ENABLED=false

# Frontend origin (CORS)
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Backend / API
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEMO_MODE=true

# Database (optional Supabase)
DATABASE_URL=postgresql://apex:apex_secret@localhost:5432/apex_casino
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth secrets
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars

# Wallet / Telebirr merchant (display + settlement match)
TELEBIRR_MERCHANT_PHONE=0977832379
TELEBIRR_MERCHANT_NAME=Menelik
WALLET_MIN_DEPOSIT=10
WALLET_MAX_DEPOSIT=50000

# Verify.ET — required for live Telebirr deposit verification
# https://verify.et/docs  |  check status: /api/verify-et/status
VERIFY_ET_API_KEY=
VERIFY_ET_BASE_URL=https://verify.et
VERIFY_ET_WEBHOOK_SECRET=

# Seed accounts (local only)
SEED_DEMO_CREDITS=100
SEED_ADMIN_EMAIL=admin@apexcasino.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_PHONE=+251918006053
SEED_PLAYER_EMAIL=demo@apexcasino.com
SEED_PLAYER_PASSWORD=Demo123!
SEED_PLAYER_PHONE=+251922000000
