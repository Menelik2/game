NODE_ENV=development
DEMO_MODE=true
REAL_MONEY_ENABLED=false

# Frontend origin (used by backend CORS)
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Backend URL (server-side + docs)
API_URL=http://localhost:3001

# Frontend must use NEXT_PUBLIC_ so the browser can reach the API
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEMO_MODE=true

DATABASE_URL=postgresql://apex:apex_secret@localhost:5432/apex_casino
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars

SEED_DEMO_CREDITS=10000
SEED_ADMIN_EMAIL=admin@apexcasino.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_PLAYER_EMAIL=demo@apexcasino.com
SEED_PLAYER_PASSWORD=Demo123!
