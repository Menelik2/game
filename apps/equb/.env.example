# Public
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never expose to the browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Admin bootstrap (hashed into DB on first login request — not shown in UI)
ADMIN_PHONE=+2519xxxxxxxx
ADMIN_PASSWORD=change-me-strong-secret

# Optional platform fee (0.15 = 15%)
PLATFORM_FEE_RATE=0.15

REAL_MONEY_ENABLED=false
TELEBIRR_MERCHANT_PHONE=
TELEBIRR_MERCHANT_NAME=
VERIFY_ET_API_KEY=
