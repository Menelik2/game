# NestJS API local .env — fill secrets before running

NODE_ENV=development
PORT=3001
API_PREFIX=api

DEMO_MODE=false
REAL_MONEY_ENABLED=true
SYNC_DB=true
TYPEORM_LOGGING=false

APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://abelgame.vercel.app
API_URL=http://localhost:3001

DATABASE_URL=postgresql://apex:apex_secret@localhost:5432/apex_casino
DATABASE_SSL=false

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
ENCRYPTION_KEY=change-me-32-byte-hex-or-string

COOKIE_DOMAIN=
COOKIE_SECURE=false
